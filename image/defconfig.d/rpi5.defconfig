# ---- Raspberry Pi 5 / 500 / 500+ / CM5 / CM5 Lite (BCM2712) ------------------
# This board uses a newer kernel commit than the Pi 3 and Pi 4 ones: Linux 6.6.74
# (tag stable_20250127 of the rpi-6.6.y branch), the first with the Pi 500 device
# tree. The commit Buildroot pins (6.6.28) has none for the Pi 500/500+ or the CM5 Lite.
# Its hash is in image/patches/linux/linux.hash.
BR2_cortex_a76=y
BR2_LINUX_KERNEL_CUSTOM_TARBALL_LOCATION="$(call github,raspberrypi,linux,a18d9ced4965462cb7b3b4252ada440395105308)/linux-a18d9ced4965462cb7b3b4252ada440395105308.tar.gz"
BR2_LINUX_KERNEL_DEFCONFIG="bcm2712"
# 4 KiB pages, as in Buildroot's own Pi 5 defconfig (the Pi OS kernel uses 16 KiB).
BR2_LINUX_KERNEL_CONFIG_FRAGMENT_FILES="board/raspberrypi/linux-4k-page-size.fragment $(BR2_EXTERNAL_EMM_PATH)/board/emm/linux.fragment"
BR2_LINUX_KERNEL_INTREE_DTS_NAME="broadcom/bcm2712-rpi-5-b broadcom/bcm2712d0-rpi-5-b broadcom/bcm2712-rpi-500 broadcom/bcm2712-rpi-cm5-cm5io broadcom/bcm2712-rpi-cm5-cm4io broadcom/bcm2712-rpi-cm5l-cm5io broadcom/bcm2712-rpi-cm5l-cm4io"

BR2_ROOTFS_POST_SCRIPT_ARGS="rpi5"
