# ---- shared by the board builds: kernel, device trees, modules, firmware ------------------------
# Each board is built from its own defconfig (this file + board file) and yields that board's
# kernel, device trees, GPU firmware and a cpio archive with the kernel's modules. The system itself
# is built once, from userland.defconfig. Buildroot 2025.02.x (LTS); image/check-defconfig.sh
# re-checks every symbol against the real Kconfig on every build.

# Toolchain: internal, glibc, C only (the kernel needs no C++). It is built here rather than
# downloaded: Bootlin's prebuilt toolchains only run on x86_64 hosts, and this build also runs
# in Docker on Apple-silicon Macs. The kernel headers are the kernel's own (headers "same as kernel").
BR2_aarch64=y
BR2_TOOLCHAIN_BUILDROOT_GLIBC=y
BR2_PACKAGE_HOST_LINUX_HEADERS_CUSTOM_6_6=y
# Buildroot's own Raspberry Pi hashes, plus ours (image/patches/) for kernel commits it does not pin.
BR2_GLOBAL_PATCH_DIR="board/raspberrypi/patches $(BR2_EXTERNAL_EMM_PATH)/patches"
BR2_DOWNLOAD_FORCE_CHECK_HASHES=y
# Compiler cache: the kernel is most of the build time. The cache lives in the download volume;
# docker-build.sh sets BR2_CCACHE_DIR for it.
BR2_CCACHE=y

# The modules end up in /usr/lib/modules (as in the system build, which has /lib -> usr/lib).
BR2_ROOTFS_MERGED_USR=y
BR2_ROOTFS_POST_IMAGE_SCRIPT="$(BR2_EXTERNAL_EMM_PATH)/board/emm/post-image.sh"

# Kernel: Raspberry Pi's tree (the commit is chosen per board, in its own file; every
# commit needs a hash in Buildroot's or our linux.hash). Defconfig and device trees
# are per board too.
BR2_LINUX_KERNEL=y
BR2_LINUX_KERNEL_CUSTOM_TARBALL=y
BR2_LINUX_KERNEL_IMAGE=y
BR2_LINUX_KERNEL_DTS_SUPPORT=y
BR2_LINUX_KERNEL_NEEDS_HOST_OPENSSL=y
# The kernel travels as a separate file next to the initramfs, not inside it (its modules do:
# post-image.sh packs them into modules-<board>.cpio.gz).
# BR2_LINUX_KERNEL_INSTALL_TARGET is not set
# depmod for the modules, with support for compressed ones.
BR2_PACKAGE_HOST_KMOD_XZ=y

# Buildroot wants some root filesystem format; this one is tiny (the modules and a skeleton)
# and not used: the system comes from the userland build.
BR2_TARGET_ROOTFS_CPIO=y
BR2_TARGET_ROOTFS_CPIO_GZIP=y
# BR2_TARGET_ROOTFS_TAR is not set
