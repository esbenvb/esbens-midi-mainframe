# GENERATED by image/mkconfigs.sh from image/defconfig.d/{userland}.defconfig.
# Do not edit this file; edit the sources and run image/mkconfigs.sh.

# ---- the system every board runs: userland, without kernel, modules or emmd -------------------
# One build serves the Pi 3, 4 and 5 (image/combine... scripts/combine-payload.sh adds each
# board's kernel modules to it, and emmd comes from the boot partition). Buildroot 2025.02.x
# (LTS). Every symbol below was checked against that release's Config.in files;
# image/check-defconfig.sh re-checks them against the real Kconfig on every build.

# Toolchain: internal, glibc (systemd needs glibc), C++ (as in upstream's Pi configs).
# Cortex-A53 is the oldest core of the three boards (Pi 3), so this code runs on all of them.
BR2_aarch64=y
BR2_cortex_a53=y
BR2_TOOLCHAIN_BUILDROOT_GLIBC=y
BR2_TOOLCHAIN_BUILDROOT_CXX=y
# No kernel in this build: the headers come from kernel.org's 6.6 series, which is what the
# boards' Raspberry Pi kernels (6.6.x) run. The headers must not be newer than the series.
BR2_KERNEL_HEADERS_6_6=y
BR2_DOWNLOAD_FORCE_CHECK_HASHES=y
# Compiler cache: speeds up rebuilds. The cache lives in the download volume; docker-build.sh
# sets BR2_CCACHE_DIR for it.
BR2_CCACHE=y

# System
BR2_INIT_SYSTEMD=y
BR2_TARGET_GENERIC_HOSTNAME="emm"
BR2_TARGET_GENERIC_ISSUE="EMM MIDI Mainframe"
BR2_TARGET_GENERIC_GETTY_PORT="tty1"
BR2_ROOTFS_OVERLAY="$(BR2_EXTERNAL_EMM_PATH)/board/emm/overlay"
BR2_ROOTFS_POST_BUILD_SCRIPT="$(BR2_EXTERNAL_EMM_PATH)/board/emm/post-build.sh"
BR2_ROOTFS_POST_IMAGE_SCRIPT="$(BR2_EXTERNAL_EMM_PATH)/board/emm/post-image.sh"
BR2_ROOTFS_POST_SCRIPT_ARGS="userland"

# Network management belongs to NetworkManager, name resolution to NM's own writer.
# BR2_PACKAGE_SYSTEMD_NETWORKD is on by default; both must be off.
# BR2_PACKAGE_SYSTEMD_NETWORKD is not set
# BR2_PACKAGE_SYSTEMD_RESOLVED is not set
# Not needed on a headless box.
# BR2_PACKAGE_SYSTEMD_VCONSOLE is not set
BR2_PACKAGE_SYSTEMD_HOSTNAMED=y
BR2_PACKAGE_SYSTEMD_TIMESYNCD=y
# Buildroot's systemd.mk builds systemd with -Dseccomp=disabled unless libseccomp is
# enabled (package/systemd/Config.in does not select it). packaging/systemd/emmd.service
# uses LockPersonality=, RestrictSUIDSGID=, RestrictNamespaces= and
# SystemCallArchitectures=, which are seccomp filters: without this line systemd
# skips them. (The kernel side, CONFIG_SECCOMP, is in kernel-required.txt.)
BR2_PACKAGE_LIBSECCOMP=y

# No kernel here (see kernel-common.defconfig); the modules of each board come with its kernel.
BR2_PACKAGE_BUSYBOX_SHOW_OTHERS=y
BR2_PACKAGE_XZ=y
BR2_PACKAGE_KMOD=y
BR2_PACKAGE_KMOD_TOOLS=y

# Root filesystem: a gzip'd cpio archive, loaded by the Pi firmware as an initramfs.
BR2_TARGET_ROOTFS_CPIO=y
BR2_TARGET_ROOTFS_CPIO_GZIP=y
# BR2_TARGET_ROOTFS_TAR is not set

# Networking: NetworkManager with WiFi (wpa_supplicant over D-Bus, AP mode for the
# setup network) and its own dnsmasq for the access point's DHCP/DNS.
BR2_PACKAGE_NETWORK_MANAGER=y
BR2_PACKAGE_NETWORK_MANAGER_CLI=y
BR2_PACKAGE_WPA_SUPPLICANT=y
BR2_PACKAGE_WPA_SUPPLICANT_NL80211=y
BR2_PACKAGE_WPA_SUPPLICANT_AP_SUPPORT=y
BR2_PACKAGE_WPA_SUPPLICANT_WPA3=y
BR2_PACKAGE_WPA_SUPPLICANT_DBUS=y
BR2_PACKAGE_WPA_SUPPLICANT_CLI=y
BR2_PACKAGE_DNSMASQ=y
# BR2_PACKAGE_DNSMASQ_TFTP is not set
BR2_PACKAGE_IW=y
BR2_PACKAGE_WIRELESS_REGDB=y
BR2_PACKAGE_UTIL_LINUX_BINARIES=y
BR2_PACKAGE_UTIL_LINUX_RFKILL=y

# mDNS: emm.local and the RTP-MIDI service announcements (service files).
BR2_PACKAGE_AVAHI=y
BR2_PACKAGE_AVAHI_DAEMON=y
# BR2_PACKAGE_AVAHI_AUTOIPD is not set

# Bluetooth: bluetoothd for the BLE-MIDI GATT server (emmd talks to it over D-Bus).
BR2_PACKAGE_BLUEZ5_UTILS=y
BR2_PACKAGE_BLUEZ5_UTILS_CLIENT=y
BR2_PACKAGE_BLUEZ5_UTILS_MONITOR=y
# BR2_PACKAGE_BLUEZ5_UTILS_PLUGINS_NETWORK is not set

# SSH: Dropbear. Nothing enables it; emmd starts packaging/systemd/emm-ssh.service when
# the user switches SSH on in the web UI (and sets a password or key there).
BR2_PACKAGE_DROPBEAR=y
# BR2_PACKAGE_DROPBEAR_CLIENT is not set
BR2_PACKAGE_DROPBEAR_DISABLE_REVERSEDNS=y

# Firmware blobs for the Pi's WiFi/Bluetooth chip (BCM43455 and relatives).
BR2_PACKAGE_BRCMFMAC_SDIO_FIRMWARE_RPI=y
BR2_PACKAGE_BRCMFMAC_SDIO_FIRMWARE_RPI_BT=y
BR2_PACKAGE_BRCMFMAC_SDIO_FIRMWARE_RPI_WIFI=y

# fsck.fat: systemd-fsck repairs the FAT32 boot partition after a power cut.
BR2_PACKAGE_DOSFSTOOLS=y
BR2_PACKAGE_DOSFSTOOLS_FSCK_FAT=y
