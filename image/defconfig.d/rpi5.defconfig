# ---- Raspberry Pi 5 / CM5 (BCM2712) ------------------------------------------
# The device trees below are the ones this kernel commit (Linux 6.6.28) has for
# the Pi 5 and the CM5 (on the CM5 IO and CM4 IO boards). The Pi 500/500+ and the
# CM5 Lite have no device tree in it (no bcm2712-rpi-500 or bcm2712-rpi-cm5l-*), so
# the image does not support them.
BR2_cortex_a76=y
BR2_LINUX_KERNEL_DEFCONFIG="bcm2712"
# 4 KiB pages, as in Buildroot's own Pi 5 defconfig (the Pi OS kernel uses 16 KiB).
BR2_LINUX_KERNEL_CONFIG_FRAGMENT_FILES="board/raspberrypi/linux-4k-page-size.fragment $(BR2_EXTERNAL_EMM_PATH)/board/emm/linux.fragment"
BR2_LINUX_KERNEL_INTREE_DTS_NAME="broadcom/bcm2712-rpi-5-b broadcom/bcm2712d0-rpi-5-b broadcom/bcm2712-rpi-cm5-cm5io broadcom/bcm2712-rpi-cm5-cm4io"

BR2_ROOTFS_POST_SCRIPT_ARGS="rpi5"
